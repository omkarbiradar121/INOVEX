# ==============================================================================
# INOVEX — Environment Configuration Template
# ==============================================================================

# Gemini AI / LLM API Key (for Manufacturing Assistant & Incident RAG)
GEMINI_API_KEY=your_gemini_api_key_here

# Database Configuration (MySQL 8.0+)
MYSQL_DATABASE=inovex_db
MYSQL_USER=inovex_user
MYSQL_PASSWORD=your_secure_password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Asynchronous Task Queue / Broker (Redis)
REDIS_URL=redis://127.0.0.1:6379/0

# Django Security Settings
SECRET_KEY=generate-a-secure-random-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Local Development Demo Account Passwords (Optional for local seed_data)
# If left unset, high-entropy random passwords are automatically generated and displayed in console
SEED_ADMIN_PASSWORD=your_local_admin_password_here
SEED_ENGINEER_PASSWORD=your_local_engineer_password_here
SEED_SUPERVISOR_PASSWORD=your_local_supervisor_password_here
